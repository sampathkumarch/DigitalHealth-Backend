APP_NAME=Health Backend
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Postgres. Point this at PgBouncer and set DB_PGBOUNCER=true in transaction mode.
DATABASE_URL=postgresql+psycopg://health:health@127.0.0.1:5432/health
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_PGBOUNCER=false

REDIS_URL=redis://127.0.0.1:6379/0

# Replace these before any shared environment.
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_PEPPER=change-me-otp
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_SEND_LIMIT=5
OTP_SEND_WINDOW_SECONDS=900
OTP_VERIFY_LIMIT=10
# Local only, so you can read the code before WhatsApp and email are connected.
OTP_STORE_PLAINTEXT=true
OTP_EXPOSE_IN_RESPONSE=true

# Leave the bucket empty to store uploads on local disk. Fill these in for S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_KEY_PREFIX=
S3_ENDPOINT_URL=
S3_PRESIGN_TTL_SECONDS=900
LOCAL_STORAGE_DIR=var/uploads
MAX_UPLOAD_BYTES=5242880

# WhatsApp Cloud API. Template must have one body variable for the code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0

# SMTP. Leave the host empty until the mailbox is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
